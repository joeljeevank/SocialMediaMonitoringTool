# LinkedIn OAuth & Scraper Settings
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3001/auth/linkedin/callback
LINKEDIN_LI_AT_COOKIE=your_linkedin_cookie

# SMTP Email Settings
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# PostgreSQL Database
DB_PASSWORD=your_postgres_password

# Google / YouTube OAuth & API Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/youtube/auth/callback
YOUTUBE_API_KEY=your_optional_youtube_api_key
